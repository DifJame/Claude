{
  "$meta": {
    "project": "Top Agency / Moscow-City.Online",
    "theme": "Obsidian (база)",
    "version": "1.0",
    "note": "Финальные дизайн-токены. CSS-источник: assets/tokens.css. Правило акцента — 90/8/2: 90% фон/поверхности, 8% текст/линии, 2% accent."
  },
  "color": {
    "obsidian": {
      "bg":        "#1A1B1D",
      "bg-2":      "#161718",
      "bg-3":      "#0F1011",
      "surface":   "#222426",
      "surface-2": "#2A2D30",
      "ink":       "#ECEFF3",
      "ink-2":     "rgba(236,239,243,0.64)",
      "ink-3":     "rgba(236,239,243,0.42)",
      "line":      "rgba(160,185,215,0.14)",
      "line-2":    "rgba(160,185,215,0.24)",
      "line-3":    "rgba(160,185,215,0.38)",
      "accent":      "#6F9BD1",
      "accent-deep": "#A9C9EC",
      "accent-soft": "rgba(111,155,209,0.10)",
      "on-accent":   "#0E1116",
      "positive":    "#6E9C84"
    },
    "midnight": {
      "bg":        "#0B1226",
      "bg-2":      "#091020",
      "bg-3":      "#060B17",
      "surface":   "#111A32",
      "surface-2": "#16203D",
      "ink":       "#EAF0FA",
      "ink-2":     "rgba(234,240,250,0.66)",
      "ink-3":     "rgba(234,240,250,0.44)",
      "line":      "rgba(150,180,220,0.16)",
      "line-2":    "rgba(150,180,220,0.28)",
      "line-3":    "rgba(150,180,220,0.42)",
      "accent":      "#7FAEE0",
      "accent-deep": "#B6D5F4",
      "accent-soft": "rgba(127,174,224,0.12)",
      "on-accent":   "#07111F",
      "positive":    "#6E9C84"
    },
    "quiet": {
      "bg":        "#F7F5F1",
      "bg-2":      "#F1EEE7",
      "bg-3":      "#E9E5DB",
      "surface":   "#FFFFFF",
      "surface-2": "#FBFAF6",
      "ink":       "#14171A",
      "ink-2":     "rgba(20,23,26,0.66)",
      "ink-3":     "rgba(20,23,26,0.46)",
      "line":      "rgba(20,23,26,0.12)",
      "line-2":    "rgba(20,23,26,0.20)",
      "line-3":    "rgba(20,23,26,0.32)",
      "accent":      "#A9824C",
      "accent-deep": "#8A6A3C",
      "accent-soft": "rgba(169,130,76,0.10)",
      "on-accent":   "#FFFFFF",
      "positive":    "#5B7B5E"
    }
  },
  "typography": {
    "fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "weights": { "light": 300, "regular": 400, "medium": 500, "semibold": 600 },
    "tracking": { "display": "-0.035em", "tight": "-0.03em", "head": "-0.02em", "body": "0", "caption": "0.2em" },
    "lineHeight": { "display": 0.95, "tight": 1.02, "head": 1.1, "body": 1.6, "relaxed": 1.74 },
    "scale": {
      "display": { "size": "clamp(44px, 7vw, 116px)", "weight": 300, "tracking": "-0.035em", "lineHeight": 0.95, "use": "Hero" },
      "h1":      { "size": "clamp(40px, 6vw, 96px)",  "weight": 300, "tracking": "-0.03em",  "lineHeight": 0.95, "use": "Крупные заголовки" },
      "h2":      { "size": "clamp(28px, 3.6vw, 52px)","weight": 300, "tracking": "-0.02em",  "lineHeight": 1.02, "use": "Заголовки секций" },
      "h3":      { "size": "clamp(22px, 2vw, 30px)",  "weight": 400, "tracking": "-0.02em",  "lineHeight": 1.1,  "use": "Заголовки карточек/строк" },
      "lead":    { "size": "clamp(16px, 1.35vw, 20px)","weight": 400,"tracking": "0",        "lineHeight": 1.6,  "use": "Лид/подзаголовок" },
      "body":    { "size": "16px", "weight": 400, "tracking": "0", "lineHeight": 1.74, "use": "Основной текст" },
      "sm":      { "size": "14px", "weight": 400, "tracking": "0", "lineHeight": 1.5,  "use": "Мелкий текст, мета" },
      "caption": { "size": "11.5px", "weight": 500, "tracking": "0.2em", "lineHeight": 1.2, "textTransform": "uppercase", "use": "Eyebrow, лейблы" }
    },
    "numeric": "font-variant-numeric: tabular-nums — для цен, ставок, площадей, этажей"
  },
  "spacing": { "1": "8px", "2": "16px", "3": "24px", "4": "32px", "6": "48px", "8": "64px", "12": "96px", "16": "128px" },
  "layout": {
    "container": "100%",
    "padX": "clamp(22px, 5vw, 96px)",
    "sectionY": "clamp(72px, 10vh, 144px)"
  },
  "radius": { "base": "4px", "lg": "8px", "pill": "999px" },
  "motion": {
    "ease": "cubic-bezier(0.22, 1, 0.36, 1)",
    "durationFast": "0.3s",
    "duration": "0.4s",
    "durationSlow": "0.8s",
    "note": "«Замедленное время»: 300–800ms, плавное затухание, без bounce. Запрещены glow, цветные тени, автоплей."
  },
  "effects": {
    "photoFilter": {
      "obsidian": "grayscale(0.12) saturate(0.8) brightness(0.84) contrast(1.03)",
      "quiet": "saturate(0.86) brightness(0.98) contrast(1.01)",
      "note": "Успокаивает открыточные фото под тёмную премиальную тему"
    },
    "shadow": "Только нейтральные мягкие тени для подъёма карточек. Без accent-свечения.",
    "border": "Hairline 1px на токенах line / line-2 / line-3"
  }
}
